# Alleyfit Wellness Studio — Environment template
# `.env.local` olarak kopyala, değerleri doldur. .env.local Git'e gitmemeli (.gitignore'a ekli).

# Supabase (https://app.supabase.com → Project → Settings → API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Admin email allowlist — virgülle ayır. Supabase Auth ile login olan
# bu emaildeki kullanıcılar admin paneline erişebilir.
VITE_ADMIN_EMAILS=alleynavrmaz@gmail.com,omrkya@gmail.com
